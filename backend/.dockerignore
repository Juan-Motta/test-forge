# Build context for backend/Dockerfile: only pyproject.toml, uv.lock, README.md, alembic.ini,
# migrations/ and src/ are needed.
.venv/
runs/
tests/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
# Secrets never enter the image; the container is configured with environment variables.
.env
.env.*
Dockerfile
.dockerignore
docker-compose.yml
