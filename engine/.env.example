# Copy to engine/.env (never commit it) or export these variables. Values are placeholders.

# PostgreSQL, async driver required. Matches docker-compose.yml for local development.
DATABASE_URL=postgresql+asyncpg://voice_eval:voice_eval@localhost:5432/voice_eval

# Encrypts stored provider secrets (used from the connections module on). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VOICE_EVAL_MASTER_KEY=

# Login sessions.
SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=ve_session
# Keep true anywhere but plain-http localhost development.
SESSION_COOKIE_SECURE=true

# Comma-separated browser origins allowed by CORS and by the CSRF Origin check.
WEB_ORIGINS=http://localhost:3000

# `development` enables /docs and /openapi.json.
ENVIRONMENT=development
