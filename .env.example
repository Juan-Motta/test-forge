# Settings for the root compose.yaml. Copy to `.env` (gitignored) and fill in the secrets:
#   cp .env.example .env
# Placeholders only: never commit real values.

# Required. PostgreSQL password; it is embedded in DATABASE_URL, so keep it URL-safe, e.g.
#   openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Required. Fernet key(s) that encrypt stored provider secrets (comma-separated for rotation).
# Losing every key makes stored secrets unrecoverable. Generate one with:
#   openssl rand -base64 32 | tr '+/' '-_'
# or, from backend/:
#   uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
VOICE_EVAL_MASTER_KEY=change-me

# Optional. Host port of the frontend (bound to 127.0.0.1). Default 3000.
# FRONTEND_PORT=3000

# Optional. `production` (default) or `development` (serves /docs, lifts the SSRF guard for
# connection tests and accepts http://localhost URLs). Keep `production` unless you need those.
# ENVIRONMENT=production

# Optional. Database user and name (not secrets). Defaults: voice_eval / voice_eval.
# POSTGRES_USER=voice_eval
# POSTGRES_DB=voice_eval

# Optional. Browser origins allowed by the backend (comma-separated).
# Default: http://localhost:<FRONTEND_PORT>
# WEB_ORIGINS=http://localhost:3000

# Optional. Set to `true` when the frontend is served over HTTPS (the browser then sends the
# session cookie only over TLS). Default `false` for plain-HTTP localhost.
# SESSION_COOKIE_SECURE=false

# Optional. Peers whose X-Forwarded-For the backend trusts (see README before changing).
# FORWARDED_ALLOW_IPS=127.0.0.1
